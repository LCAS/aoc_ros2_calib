<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2-calib</name>
  <version>0.1.1</version>
  <description>A manual LiDAR-Camera calibration tool for ROS 2</description>

  <maintainer email="marc@hanheide.net">Marc Hanheide</maintainer>

  <license>MIT</license>

  <url type="website">https://github.com/ika-rwth-aachen/ros2_calib</url>
  <url type="bugtracker">https://github.com/ika-rwth-aachen/ros2_calib/issues</url>
  <url type="repository">https://github.com/ika-rwth-aachen/ros2_calib</url>

  <author email="till.beemelmanns@rwth-aachen.de">Till Beemelmanns</author>

  <!-- Build tool dependencies -->
  <buildtool_depend>python3-setuptools</buildtool_depend>

  <!-- Python dependencies (these are handled by pip/pyproject.toml, but listed here for ROS ecosystem compatibility) -->
  <!-- <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyside2</exec_depend>
  <exec_depend>python3-setuptools</exec_depend> -->

  <!-- This is a pure Python package that processes ROS 2 data offline -->
  <!-- It does not require ROS 2 runtime dependencies -->
  
  <export>
    <build_type>python</build_type>
    <!-- Indicate this is a pure Python package, not a ROS 2 package -->
    <python_setup_py>false</python_setup_py>
  </export>

</package>